{
   "name": "graphandphotos",
   "version": "0.1.0",
   "private": true,
   "scripts": {
      "dev": "next dev",
      "build": "NODE_ENV=production next build",
      "start": "next start",
      "docker:up": "docker compose -f compose.yml -f docker-compose.override.yml up --build",
      "docker:down": "docker compose -f compose.yml -f docker-compose.override.yml down",
      "docker:prod": "docker compose -f compose.yml up --build -d",
      "docker:prod:down": "docker compose -f compose.yml down",
      "dev:docker": "concurrently -k \"PORT=3003 node --watch server.js\" \"npx wait-on -t 10000 http://localhost:3003 && npx browser-sync start -c bs-config.docker.js\"",
      "docker:build": "docker compose -f compose.yml build",
      "docker:push": "docker compose -f compose.yml push",
      "docker:deploy": "docker compose -f compose.yml build && docker compose -f compose.yml push"
   },
   "dependencies": {
      "@aws-sdk/client-s3": "^3.1116.0",
      "@aws-sdk/s3-request-presigner": "^3.1116.0",
      "@radix-ui/react-avatar": "^1.2.6",
      "@radix-ui/react-collapsible": "^1.1.20",
      "@radix-ui/react-dialog": "^1.1.23",
      "@radix-ui/react-dropdown-menu": "^2.1.24",
      "@radix-ui/react-separator": "^1.1.15",
      "@radix-ui/react-slot": "^1.3.3",
      "@radix-ui/react-tooltip": "^1.2.16",
      "bcryptjs": "^3.0.3",
      "class-variance-authority": "^0.7.1",
      "clsx": "^2.1.1",
      "exifr": "^7.1.3",
      "lucide-react": "^1.33.0",
      "motion": "^13.1.1",
      "mysql2": "^3.23.4",
      "next": "16.3.2",
      "postcss": "^8.5.26",
      "radix-ui": "^1.6.7",
      "react": "19.2.8",
      "react-dom": "19.2.8",
      "sharp": "^0.34.5",
      "sonner": "^2.0.8",
      "tailwind-merge": "^3.6.0",
      "vaul": "^1.1.2"
   },
   "devDependencies": {
      "@tailwindcss/postcss": "^4.3.3",
      "tailwindcss": "^4.3.3",
      "tw-animate-css": "^1.4.0"
   }
}
